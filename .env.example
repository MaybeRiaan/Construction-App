# Copy to .env.local and fill in to connect Playdar to its backend.
# Without these, the app runs fully on-device with the Riverbend demo town.

# Supabase project (see supabase/README.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your own Overpass (OpenStreetMap) endpoint for live place imports
# EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
